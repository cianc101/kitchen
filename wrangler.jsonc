{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kitchen",
  "main": "src/secure.js",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://cian-cj11.cloudflareaccess.com",
    "ACCESS_POLICY_AUD": "REPLACE_WITH_ACCESS_AUD",
    "DEV_ALLOW_UNAUTHENTICATED": "false"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kitchen-db",
      "database_id": "85fd021b-be0c-4de0-b82c-5e5df582c226"
    }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
